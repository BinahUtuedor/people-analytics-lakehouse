# =============================================================================
# People Analytics Lakehouse Platform
# Environment Configuration Template
#
# Copy this file to `.env` for local development:
#
#     Copy-Item .env.example .env
#
# Never commit `.env` or any file containing real credentials, tokens,
# passwords, account-specific secrets, or private connection details.
# =============================================================================

# =============================================================================
# APPLICATION
# =============================================================================
PROJECT_NAME=People Analytics Lakehouse Platform
ENVIRONMENT=development
LOG_LEVEL=INFO

# =============================================================================
# POSTGRESQL
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DATABASE=people_analytics
POSTGRES_USER=postgres

# Set locally. Never commit a real password.
POSTGRES_PASSWORD=

# =============================================================================
# AWS
# =============================================================================
AWS_REGION=eu-west-2

# Set this to the authorised S3 bucket for your environment.
AWS_S3_BUCKET=

AWS_S3_RAW_PREFIX=raw/postgresql
AWS_S3_BRONZE_PREFIX=bronze
AWS_S3_SILVER_PREFIX=silver
AWS_S3_GOLD_PREFIX=gold

# =============================================================================
# AWS CREDENTIALS
# =============================================================================
# Local development supports the standard AWS environment-variable names.
#
# DO NOT place real credentials in this file.
#
# Long-lived IAM user credentials:
#   AWS_ACCESS_KEY_ID=<your-access-key-id>
#   AWS_SECRET_ACCESS_KEY=<your-secret-access-key>
#   AWS_SESSION_TOKEN=
#
# Temporary credentials:
#   populate all three values.
#
# Prefer IAM roles / temporary credentials in managed AWS environments.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# =============================================================================
# DATABRICKS
# =============================================================================
# Databricks settings are used as the AWS Databricks lakehouse is introduced.
#
# Keep DATABRICKS_TOKEN in `.env` or an approved secrets-management system.
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

DATABRICKS_CATALOG=people_analytics
DATABRICKS_SCHEMA=bronze

# =============================================================================
# SPARK
# =============================================================================
SPARK_APP_NAME=people-analytics-lakehouse
SPARK_MASTER=local[*]
SPARK_LOG_LEVEL=WARN

# Optional Maven package list.
# Leave blank unless the local Spark environment requires additional packages.
#
# For S3A, the hadoop-aws version must be compatible with the Hadoop version
# used by the installed Spark distribution.
#
# Example:
# SPARK_JARS_PACKAGES=org.apache.hadoop:hadoop-aws:<matching-version>
SPARK_JARS_PACKAGES=
